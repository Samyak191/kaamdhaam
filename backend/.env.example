NODE_ENV=development
HOST=127.0.0.1
PORT=4000
TRUST_PROXY_HOPS=0
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_WRITE_PER_MINUTE=30
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://kaamdham_dev:replace_with_local_secret@127.0.0.1:5432/kaamdham_dev?schema=public
POSTGRES_DB=kaamdham_dev
POSTGRES_USER=kaamdham_dev
POSTGRES_PASSWORD=replace_with_local_secret
POSTGRES_PORT=5432
TEST_DATABASE_URL=postgresql://kaamdham_test:replace_with_test_secret@127.0.0.1:5433/kaamdham_test?schema=public
TEST_POSTGRES_DB=kaamdham_test
TEST_POSTGRES_USER=kaamdham_test
TEST_POSTGRES_PASSWORD=replace_with_test_secret
TEST_POSTGRES_PORT=5433
SUPABASE_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Public key used only by local auth smoke scripts; never use a service-role key here.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_project_key
